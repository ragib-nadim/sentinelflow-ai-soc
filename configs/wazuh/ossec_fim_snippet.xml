<!-- SentinelFlow AI SOC: Windows Wazuh Agent Real-Time FIM Configuration -->
<!-- File Location: C:\Program Files (x86)\ossec-agent\ossec.conf -->
<ossec_config>
  <syscheck>
    <disabled>no</disabled>
    <frequency>43200</frequency>

    <!-- Database synchronization settings -->
    <synchronization>
      <enabled>yes</enabled>
      <interval>5m</interval>
      <max_eps>10</max_eps>
    </synchronization>

    <!-- Real-time File Integrity Monitoring for SentinelFlow Monitored Directory -->
    <directories check_all="yes" report_changes="yes" realtime="yes">E:\Personal Projects\sentinelflow-ai-soc\monitored_directory</directories>
  </syscheck>
</ossec_config>
